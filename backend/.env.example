# ============================================================
# AdMu 環境変数設定テンプレート
# このファイルを .env にコピーして使用してください
# cp .env.example .env
# ============================================================

# --- アプリ設定 ---
PORT=8001
DEBUG=false

# --- Google Gemini API ---
# https://aistudio.google.com/app/apikey から取得
GEMINI_API_KEY=

# --- Google Ads API ---
# https://developers.google.com/google-ads/api/docs/get-started/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=

# --- モックモード (本番APIが使えない間は true のまま) ---
MOCK_ADS_API=true

# --- Google Ads API（ads_client.py フォールバック用マスター認証情報）---
# DB未登録のクリニックに対して自動で使われるマスターMCCの認証情報
MASTER_ADS_DEVELOPER_TOKEN=
MASTER_ADS_CLIENT_ID=
MASTER_ADS_CLIENT_SECRET=
MASTER_ADS_REFRESH_TOKEN=
MASTER_ADS_LOGIN_CUSTOMER_ID=

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_DEFAULT_USER_ID=

# --- JWT認証 ---
# 本番では必ず長いランダム文字列に変更 (例: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string-in-production

# --- 管理者設定 ---
# 初回セットアップ時に使用するemail/password
ADMIN_EMAIL=admin@admu.jp
ADMIN_PASSWORD=change-me-in-production
# 初期化エンドポイント POST /api/admin/init に必要なシークレット
ADMIN_INIT_SECRET=admu-init-2024
# LP問い合わせ・資料請求の通知先メールアドレス（未設定時は info@admu.jp）
ADMIN_NOTIFICATION_EMAIL=info@admu.jp

# --- SMTPメール設定 (Gmail推奨) ---
# Gmailの場合: Googleアカウント → セキュリティ → アプリパスワードを使用
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password

# --- Resendメール設定 (推奨) ---
# https://resend.com で無料登録 → APIキー発行
# Resendがあれば上記SMTPは不要
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# --- サービスURL ---
# パスワードリセットメール等に含まれるリンクのベースURL
APP_BASE_URL=http://localhost:8001

# --- 環境識別 ---
# production でCookieのSecure属性やセキュリティ設定が有効になる
ENVIRONMENT=development

# --- システム間連携 (LOGICTION連携) ---
LOGICTION_BASE_URL=https://your-logiction-server.onrender.com
INTEGRATION_SECRET_KEY=change-me-to-a-long-random-string

# --- セキュリティ (後方互換用) ---
SECRET_KEY=change-me-in-production

# --- CORS設定 ---
# 本番では自分のドメインのみ許可（カンマ区切りで複数指定可能）
# 例: ALLOWED_ORIGINS=https://admu.yourdomain.com,https://admin.yourdomain.com
# ローカル開発時は * のままでOK
ALLOWED_ORIGINS=*

# --- データベース ---
# Render等では DATABASE_URL が自動注入される
# ローカルではSQLite使用（設定不要）
# DATABASE_URL=postgresql://user:pass@host:5432/admu_db

# --- Sentry エラー監視 ---
# https://sentry.io でプロジェクト作成後、DSNを入力
SENTRY_DSN=

# --- Stripe 決済 ---
# Stripe Dashboard → 開発者 → Webhooks → エンドポイントシークレット
# 本番では必ず設定すること（未設定の場合、決済偽装が可能になる）
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDALONE=
STRIPE_PRICE_LOGICTION_SET=

# --- DB暗号化 ---
ENCRYPTION_KEY=
